# Chart tokens + shared CSS. Edit here, never in .rs.
WORKSPACE LOCAL

TYPE TOKENS = MAP<
    heating: STRING,
    steady: STRING,
    cooling: STRING,
    dormant: STRING,
    cat3: STRING,
    cat4: STRING,
    cat5: STRING,
    cat6: STRING,
    cat7: STRING,
    ink: STRING,
    ink_on_bar: STRING,
    dim: STRING,
    portfolio_bar: STRING,
    family: STRING
>

FUNC CHART_TOKENS(): TOKENS {
    WORKSPACE LOCAL

    LET $tokens: TOKENS = {
        "heating": "#D55E00",
        "steady": "#E69F00",
        "cooling": "#56B4E9",
        "dormant": "#BBBBBB",
        "cat3": "#F0E442",
        "cat4": "#0072B2",
        "cat5": "#009E73",
        "cat6": "#CC79A7",
        "cat7": "#999999",
        "ink": "#767676",
        "ink_on_bar": "#1a1a1a",
        "dim": "#333",
        "portfolio_bar": "#222",
        "family": "Helvetica, Arial, sans-serif"
    }

    RETURN $tokens
}

FUNC CHART_STYLE(): STRING {
    WORKSPACE LOCAL
    RETURN """
        <style>
            .bar {
                stroke: #fff;
                stroke-width: 2;
                rx: 4;
            }
            .lbl {
                fill: #fff;
                font-size: 13px;
                font-weight: 600;
            }
            .sub {
                fill: #fff;
                font-size: 11px;
                opacity: .92;
            }
            .dim {
                fill: #333;
                font-size: 12px;
            }
            .wht {
                fill: #fff;
                font-size: 10px;
                paint-order: stroke;
                stroke: rgba(0, 0, 0, .45);
                stroke-width: 3px;
                stroke-linejoin: round;
            }
            .muted {
                fill: #666;
                font-size: 11px;
            }
            .pulse {
                animation: breathe 2.2s ease-in-out infinite;
            }
            .slow {
                animation-duration: 3.4s;
            }
            @keyframes breathe {
                0%, 100% { opacity: .95; }
                50% { opacity: .62; }
            }
            .halo {
                transform-box: fill-box;
                transform-origin: center;
                animation: halo 2.2s ease-out infinite;
            }
            @keyframes halo {
                0% { opacity: .75; transform: scale(1); }
                100% { opacity: 0; transform: scale(2.4); }
            }
            .card {
                opacity: 0;
                animation: whisk ease-in-out infinite;
                animation-iteration-count: infinite;
            }
            .deck .card#r0 {
                opacity: 1;
            }
            @keyframes whisk {
                0% { opacity: 0; transform: translateX(60px); }
                3% { opacity: 1; transform: translateX(0); }
                10% { opacity: 1; transform: translateX(0); }
                13% { opacity: 0; transform: translateX(-60px); }
                100% { opacity: 0; transform: translateX(-60px); }
            }
            @media (prefers-reduced-motion: reduce) {
                .pulse, .halo, .card { animation: none; }
            }
        </style>
        """
}

EXPORT [
    TYPE TOKENS,
    CHART_TOKENS,
    CHART_STYLE
]
