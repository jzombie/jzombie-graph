<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800.0 360.0" role="img" font-family="Helvetica, Arial, sans-serif"><title>Portfolio heat flame</title><text x="16" y="24" font-size="14" font-weight="bold" fill="#222">portfolio heat</text><text x="16" y="40" class="muted">width = 30d share · color = heat band · pulse = heating only</text><style>.bar{stroke:#fff;stroke-width:2;rx:4}.lbl{fill:#fff;font-size:13px;font-weight:600}.sub{fill:#fff;font-size:11px;opacity:.92}.dim{fill:#333;font-size:12px}.muted{fill:#666;font-size:11px}.pulse{animation:breathe 2.2s ease-in-out infinite}.slow{animation-duration:3.4s}@keyframes breathe{0%,100%{opacity:.95}50%{opacity:.62}}@media (prefers-reduced-motion:reduce){.pulse{animation:none}}</style><text x="16" y="60" font-size="14" fill="#767676">No commits in trailing 30d</text></svg>
