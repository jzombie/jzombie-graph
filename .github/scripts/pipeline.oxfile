# Nightly publish: build, collect the graph, write the schema, render the fragment.
# Called from publish.yml. If any step fails the run stops and the old site stays up.

INHERIT_ENV [JZOMBIE_GRAPH_TOKEN, CARGO_TARGET_DIR]

WORKSPACE LOCAL

ECHO "build: workspace -> target/release"
RUN ["cargo", "build", "--release", "--workspace"]

ECHO "collect: sweep -> data/json/portfolio-graph.json"
RUN ["./target/release/jzombie-graph", "--user", "jzombie", "--format", "json", "--output", "data/json/portfolio-graph.json"]

ECHO "schema: types -> data/json/portfolio-graph-schema.json"
RUN ["./target/release/jzombie-graph", "--format", "schema", "--output", "data/json/portfolio-graph-schema.json"]

ECHO "render: staged JSON -> data/markdown/fragments/portfolio-graph.md"
RUN ["./target/release/cartographer", "data/json/portfolio-graph.json", "--output", "data/markdown/fragments/portfolio-graph.md"]

ECHO "pipeline complete"
