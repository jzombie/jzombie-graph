# Nightly publish: build, collect the graph, write the schema, render the fragment and charts.
# Called from publish.yml. If any step fails the run stops and the old site stays up.

INHERIT_ENV [JZOMBIE_GRAPH_TOKEN, CARGO_TARGET_DIR]

WORKSPACE LOCAL

ECHO "build: workspace -> target/release"
RUN ["cargo", "build", "--release", "--workspace"]

ECHO "collect: live sweep (binary default paths)"
RUN ["./target/release/jzombie-graph", "--user", "jzombie", "--format", "json"]

ECHO "schema: types (binary default paths)"
RUN ["./target/release/jzombie-graph", "--format", "schema"]

ECHO "render: staged JSON (binary default paths)"
RUN ["./target/release/cartographer"]

ECHO "charts: share (binary default paths)"
RUN ["./target/release/charts"]

ECHO "charts: focus (binary default paths)"
RUN ["./target/release/charts", "--chart", "focus"]

ECHO "pipeline complete"
