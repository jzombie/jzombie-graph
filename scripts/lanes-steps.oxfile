# Granular RUN lanes.

INHERIT_ENV [JZOMBIE_GRAPH_TOKEN]
WORKSPACE LOCAL

# Collect: live sweep, schema rides along.
FUNC COLLECT(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: collect fresh (schema rides along)"
    RUN ["cargo", "run", "--release", "--", "--user", "jzombie", "--format", "json"]
}

# Fragment: staged JSON to markdown.
FUNC FRAGMENT(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: render the fragment"
    RUN ["cargo", "run", "--release", "-p", "jzombie-graph-cartographer"]
}

# Share: commit-share pie.
FUNC CHART_SHARE(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: share (binary default paths)"
    RUN ["cargo", "run", "--release", "-p", "jzombie-graph-charts"]
}

# Focus: focus ranking bars.
FUNC CHART_FOCUS(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: focus (binary default paths)"
    RUN ["cargo", "run", "--release", "-p", "jzombie-graph-charts", "--", "--chart", "focus"]
}

# Flame: portfolio heat flame.
FUNC CHART_FLAME(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: flame (binary default paths)"
    RUN ["cargo", "run", "--release", "-p", "jzombie-graph-charts", "--", "--chart", "flame"]
}

# Indicators: status badges.
FUNC CHART_INDICATORS(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: indicators (binary default paths)"
    RUN ["cargo", "run", "--release", "-p", "jzombie-graph-charts", "--", "--chart", "indicators"]
}

# PreviewInputs: every preview input rendered (SVGs, badge files, data
# table fragment). The proof page itself is assembled by RENDER.
FUNC PREVIEW_INPUTS(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: render preview inputs (page assembly is RENDER)"
    RUN ["cargo", "run", "--release", "-p", "jzombie-graph-charts", "--", "--chart", "preview"]
}

# Render: assemble the proof page. Lanes run with the calling oxfile's
# directory as cwd, so --root pins the renderer at the repo root.
FUNC RENDER(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: assemble the proof page"
    RUN ["oxdock-render", "--root", ".."]
}

# Drift: fail when generated outputs differ from the commit. Runs from
# the lane directory, so git targets the repo root explicitly.
FUNC DRIFT(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: drift gate"
    RUN ["git", "-C", "..", "diff", "--exit-code", "--", "preview/", "markdown/fragments/"]
}

# CommitProof: land the rebuilt proof page, data, and schema (all
# committed paths — no gitignored working copies anymore). Commits only
# on change — a quiet sweep pushes nothing. Shell form because the
# commit is conditional; a bare `git commit` would fail the lane on
# quiet nights. Runs from the lane directory, so git targets the repo
# root explicitly.
FUNC COMMIT_PROOF(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: commit rebuilt proof + data + schema"
    RUN ["git", "-C", "..", "config", "user.name", "github-actions[bot]"]
    RUN ["git", "-C", "..", "config", "user.email", "github-actions[bot]@users.noreply.github.com"]
    RUN ["git", "-C", "..", "add", "preview", "json", "svg", "markdown"]
    RUN ["sh", "-c", "git -C .. diff --cached --quiet || git -C .. commit -m 'nightly rebuild'"]
    RUN ["git", "-C", "..", "push"]
}

EXPORT [FUNC COLLECT, FUNC FRAGMENT, FUNC CHART_SHARE, FUNC CHART_FOCUS, FUNC CHART_FLAME, FUNC CHART_INDICATORS, FUNC PREVIEW_INPUTS, FUNC RENDER, FUNC DRIFT, FUNC COMMIT_PROOF]
