# Granular RUN lanes. Each name states its artifact: COLLECT_* sweeps,
# RENDER_* writes one file, BUILD_* bundles, GATE_* fails closed.

INHERIT_ENV [JZOMBIE_GRAPH_TOKEN]
WORKSPACE LOCAL

# CollectGraph: live sweep into data/, schema rides along.
FUNC COLLECT_GRAPH(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: collect graph + schema into data/"
    RUN ["cargo", "run", "--release", "--", "--user", "jzombie", "--format", "json"]
}

# RenderMapFragment: staged JSON to the map fragment.
FUNC RENDER_MAP_FRAGMENT(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: render proof/fragments/portfolio-graph.md"
    RUN ["cargo", "run", "--release", "-p", "jzombie-graph-cartographer"]
}

# BuildProofInputs: every proof input rendered (map fragment, SVGs,
# badge files, data table fragment). Page assembly is never here —
# the outer oxdock-render owns proof/README.md.
FUNC BUILD_PROOF_INPUTS(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: render all proof inputs (page assembly is ASSEMBLE_PROOF_PAGE)"
    RUN ["cargo", "run", "--release", "-p", "jzombie-graph-charts", "--", "--chart", "preview"]
}

# AssembleProofPage: run the renderer over the committed inputs.
FUNC ASSEMBLE_PROOF_PAGE(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: assemble proof/README.md"
    RUN ["oxdock-render"]
}

# GateProofDrift: fail when generated outputs differ from the commit.
FUNC GATE_PROOF_DRIFT(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: drift gate over proof/ data/"
    RUN ["git", "diff", "--exit-code", "--", "proof/", "data/"]
}

# CommitProof: land the rebuilt proof page, data, and schema (all
# committed paths — no gitignored working copies anymore). Commits only
# on change — a quiet sweep pushes nothing. Shell form because the
# commit is conditional; a bare `git commit` would fail the lane on
# quiet nights.
FUNC COMMIT_PROOF(): VOID {
    WORKSPACE LOCAL
    ECHO "lanes: commit rebuilt proof + data"
    RUN ["git", "config", "user.name", "github-actions[bot]"]
    RUN ["git", "config", "user.email", "github-actions[bot]@users.noreply.github.com"]
    RUN ["git", "add", "proof", "data"]
    RUN ["sh", "-c", "git diff --cached --quiet || git commit -m 'nightly rebuild'"]
    RUN ["git", "push"]
}

EXPORT [
    FUNC COLLECT_GRAPH,
    FUNC RENDER_MAP_FRAGMENT,
    FUNC BUILD_PROOF_INPUTS,
    FUNC ASSEMBLE_PROOF_PAGE,
    FUNC GATE_PROOF_DRIFT,
    FUNC COMMIT_PROOF
]
