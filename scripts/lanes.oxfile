# Composed lanes. Ordering lives here once; callers make one call.
# TODO(oxdock): same as lanes-steps — in-FUNC WORKSPACE LOCAL lines go
# away once imported FUNCs bind to their own module scope.
WORKSPACE LOCAL

IMPORT ["./lanes-steps.oxfile" AS STEPS]

# CollectGraph: the live sweep alone.
FUNC COLLECT_GRAPH(): VOID {
    WORKSPACE LOCAL
    STEPS::COLLECT_GRAPH()
}

# RefreshProofInputs: proof inputs from whatever data/ holds. Assembly is
# the outer oxdock-render's job — never call STEPS::ASSEMBLE_PROOF_PAGE()
# here, or the pre-hook re-enters the renderer forever.
FUNC REFRESH_PROOF_INPUTS(): VOID {
    WORKSPACE LOCAL
    STEPS::RENDER_MAP_FRAGMENT()
    STEPS::BUILD_PROOF_INPUTS()
    ECHO "proof complete"
}

# VerifyProof: tokenless rebuild + drift gate (CI render-check).
FUNC VERIFY_PROOF(): VOID {
    WORKSPACE LOCAL
    STEPS::RENDER_MAP_FRAGMENT()
    STEPS::BUILD_PROOF_INPUTS()
    STEPS::ASSEMBLE_PROOF_PAGE()
    STEPS::GATE_PROOF_DRIFT()
    ECHO "render clean"
}

# NightlySweep: fragment + charts + proof page, collecting first when $collect.
# HALTED: imported-lane RUN executes with the lane file's directory as
# cwd, so every lane scatters outputs under scripts/ instead of the repo
# root. Do NOT run this (nightly stays red) until the oxdock engine fix
# lands and module FUNCs inherit the entry scope. Then delete the HALT
# below — nothing else here changes.
FUNC NIGHTLY_SWEEP($collect: BOOL): VOID {
    WORKSPACE LOCAL
    ECHO "HALTED: refusing nightly sweep — oxdock module-scope fix required (lanes write scripts/ instead of root)"
    EXIT 1
    IF $collect {
        STEPS::COLLECT_GRAPH()
    }
    STEPS::RENDER_MAP_FRAGMENT()
    STEPS::BUILD_PROOF_INPUTS()
    STEPS::ASSEMBLE_PROOF_PAGE()
    STEPS::COMMIT_PROOF()
    ECHO "pipeline complete"
}

EXPORT [FUNC COLLECT_GRAPH, FUNC REFRESH_PROOF_INPUTS, FUNC VERIFY_PROOF, FUNC NIGHTLY_SWEEP]
