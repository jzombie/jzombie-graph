# Composed lanes. Ordering lives here once; callers make one call.
# TODO(oxdock): same as lanes-steps — in-FUNC WORKSPACE LOCAL lines go
# away once imported FUNCs bind to their own module scope.
WORKSPACE LOCAL

IMPORT ["./lanes-steps.oxfile" AS STEPS]

# Collect: the live sweep alone.
FUNC COLLECT(): VOID {
    WORKSPACE LOCAL
    STEPS::COLLECT()
}

# BuildProof: proof inputs from whatever proof/json/ holds. Assembly is the
# outer oxdock-render's job — never call STEPS::RENDER() here, or the
# pre-hook re-enters the renderer forever.
FUNC BUILD_PROOF(): VOID {
    WORKSPACE LOCAL
    STEPS::FRAGMENT()
    STEPS::PROOF_INPUTS()
    ECHO "proof complete"
}

# Check: tokenless rebuild + drift gate (CI render-check).
FUNC CHECK(): VOID {
    WORKSPACE LOCAL
    STEPS::FRAGMENT()
    STEPS::PROOF_INPUTS()
    STEPS::RENDER()
    STEPS::DRIFT()
    ECHO "render clean"
}

# Pipeline: fragment + charts + proof page, collecting first when $collect.
# HALTED: imported-lane RUN executes with the lane file's directory as
# cwd, so every lane scatters outputs under scripts/ instead of the repo
# root. Do NOT run this (nightly stays red) until the oxdock engine fix
# lands and module FUNCs inherit the entry scope. Then delete the HALT
# below — nothing else here changes.
FUNC PIPELINE($collect: BOOL): VOID {
    WORKSPACE LOCAL
    ECHO "HALTED: refusing nightly pipeline — oxdock module-scope fix required (lanes write scripts/ instead of root)"
    EXIT 1
    IF $collect {
        STEPS::COLLECT()
    }
    STEPS::FRAGMENT()
    STEPS::CHART_SHARE()
    STEPS::CHART_FOCUS()
    STEPS::CHART_FLAME()
    STEPS::CHART_INDICATORS()
    STEPS::PROOF_INPUTS()
    STEPS::RENDER()
    STEPS::COMMIT_PROOF()
    ECHO "pipeline complete"
}

EXPORT [FUNC COLLECT, FUNC BUILD_PROOF, FUNC CHECK, FUNC PIPELINE]
