# Composed lanes. Ordering lives here once; callers make one call.
# TODO(oxdock): same as lanes-steps — in-FUNC WORKSPACE LOCAL lines go
# away once imported FUNCs bind to their own module scope.
WORKSPACE LOCAL

IMPORT ["./lanes-steps.oxfile" AS STEPS]

# Collect: the live sweep alone.
FUNC COLLECT(): VOID {
    WORKSPACE LOCAL
    STEPS::COLLECT()
}

# RenderProof: tokenless proof page from whatever json/ holds.
FUNC RENDER_PROOF(): VOID {
    WORKSPACE LOCAL
    STEPS::FRAGMENT()
    STEPS::PREVIEW_INPUTS()
    STEPS::RENDER()
    ECHO "preview complete"
}

# Check: tokenless rebuild + drift gate (CI render-check).
FUNC CHECK(): VOID {
    WORKSPACE LOCAL
    STEPS::FRAGMENT()
    STEPS::PREVIEW_INPUTS()
    STEPS::RENDER()
    STEPS::DRIFT()
    ECHO "render clean"
}

# Pipeline: fragment + charts + proof page, collecting first when $collect.
FUNC PIPELINE($collect: BOOL): VOID {
    WORKSPACE LOCAL
    IF $collect {
        STEPS::COLLECT()
    }
    STEPS::FRAGMENT()
    STEPS::CHART_SHARE()
    STEPS::CHART_FOCUS()
    STEPS::CHART_FLAME()
    STEPS::CHART_INDICATORS()
    STEPS::PREVIEW_INPUTS()
    STEPS::RENDER()
    STEPS::COMMIT_PROOF()
    ECHO "pipeline complete"
}

EXPORT [FUNC COLLECT, FUNC RENDER_PROOF, FUNC CHECK, FUNC PIPELINE]
