# Composed lanes. Ordering lives here once; callers make one call.
# TODO(oxdock): same as lanes-steps — in-FUNC WORKSPACE LOCAL lines go
# away once imported FUNCs bind to their own module scope.
WORKSPACE LOCAL

IMPORT ["../lanes-steps.oxfile" AS STEPS]

# Collect: the live sweep alone.
FUNC COLLECT() {
    WORKSPACE LOCAL
    STEPS::COLLECT()
}

# RenderProof: tokenless proof page from whatever data/ holds.
FUNC RENDER_PROOF() {
    WORKSPACE LOCAL
    STEPS::FRAGMENT()
    STEPS::PREVIEW()
    ECHO "preview complete"
}

# Pipeline: fragment + charts, collecting first when $collect.
FUNC PIPELINE($collect: BOOL) {
    WORKSPACE LOCAL
    IF $collect {
        STEPS::COLLECT()
    }
    STEPS::FRAGMENT()
    STEPS::CHART_SHARE()
    STEPS::CHART_FOCUS()
    STEPS::CHART_FLAME()
    STEPS::CHART_INDICATORS()
    ECHO "pipeline complete"
}

EXPORT [FUNC COLLECT, FUNC RENDER_PROOF, FUNC PIPELINE]
