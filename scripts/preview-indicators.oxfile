# Full render proof, one command. All paths live in the binaries
# (src/paths.rs); this script only orders the lanes. Local only.

WORKSPACE LOCAL

ECHO "preview: collect fresh"
RUN ["cargo", "run", "--quiet", "--release", "--", "--user", "jzombie", "--format", "json"]

ECHO "preview: render the fragment"
RUN ["cargo", "run", "--quiet", "--release", "-p", "jzombie-graph-cartographer"]

ECHO "preview: render everything and assemble the proof page"
RUN ["cargo", "run", "--quiet", "--release", "-p", "jzombie-graph-charts", "--", "--chart", "preview"]

ECHO "preview complete"
